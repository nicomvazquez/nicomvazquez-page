# ---------------------------------------------------------------
# Público (se incrusta en el build). Vacío = usa el valor por
# defecto de src/config/site.ts, o deja el botón deshabilitado.
# ---------------------------------------------------------------

# URL final del sitio (canonical, Open Graph, sitemap). OBLIGATORIA en producción.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Contacto
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Proyectos
NEXT_PUBLIC_BOT_REPO_URL=
# Captura real opcional (ruta en /public, p. ej. /screens/bot.png). Vacío = mockup.
NEXT_PUBLIC_BOT_SCREENSHOT=
# URL de producción del Market Monitor. Vacío = botón "Acceder al monitor" deshabilitado.
NEXT_PUBLIC_MARKET_MONITOR_URL="https://monitor-nv-consulting.vercel.app/"
NEXT_PUBLIC_MONITOR_SCREENSHOT=

# Apertura de cuenta: enlace de referido de la ALyC. Vacío = botón deshabilitado.
NEXT_PUBLIC_ALYC_REFERRAL_URL=
# Nombre del agente (opcional, sólo se muestra si se completa).
NEXT_PUBLIC_ALYC_NAME=

# Canal alternativo que se ofrece mientras el newsletter no está activo.
NEXT_PUBLIC_LINKEDIN_NEWSLETTER_URL=

# ---------------------------------------------------------------
# Servidor (secretos: nunca usar el prefijo NEXT_PUBLIC_)
# ---------------------------------------------------------------

# brevo | resend | mailchimp | custom | none
NEWSLETTER_PROVIDER=none

# Brevo
BREVO_API_KEY=
BREVO_LIST_ID=

# Resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Mailchimp (la key termina en -usXX, el data center)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Webhook propio (Make, Zapier, función serverless...). Recibe POST {name, email, source}.
NEWSLETTER_ENDPOINT=
NEWSLETTER_ENDPOINT_TOKEN=
